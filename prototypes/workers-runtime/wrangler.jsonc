{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creuza-local-only-runtime-probe",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "vars": {
    "DATABASE_URL": "postgresql://creuza_prototype@127.0.0.1:55439/creuza_workers_probe"
  },
  "r2_buckets": [
    { "binding": "DOCUMENTS", "bucket_name": "creuza-local-prototype-only" }
  ]
}
